{
  "name": "@numiko/external-links",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "release": "release-it",
    "generate-docs": "typedoc lib/external-links.ts"
  },
  "release-it": {
    "after:bump": [
      "npm run generate-docs",
      "npm run build"
    ],
    "plugins": {
      "@j-ulrich/release-it-regex-bumper": {
        "out": [
          {
            "file": "README.md",
            "search": "\\d+-\\d+-\\d+",
            "replace": "{{major}}-{{minor}}-{{patch}}"
          }
        ]
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/external-links.es.js",
      "require": "./dist/external-links.umd.js"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "happy-dom": "^15.7.4",
    "release-it": "^17.10.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@j-ulrich/release-it-regex-bumper": "^5.3.0"
  }
}
