{
  "name": "@numiko/external-links",
  "description": "External Links",
  "version": "1.5.0",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "generate-docs": "typedoc lib/external-links.ts",
    "deploy-docs": "netlify deploy --dir=docs --site=7e2d6232-b0e0-4182-b90e-7270a471aad2 --alias=v$(node -p \"require('./package.json').version\") && netlify deploy --dir=docs --site=7e2d6232-b0e0-4182-b90e-7270a471aad2 --prod",
    "release": "echo 'Releasing package. Ensure the module is linked to the Netlify project using `netlify link`.'; release-it release"
  },
  "main": "./dist/external-links.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/external-links.d.ts",
      "import": "./dist/external-links.es.js",
      "require": "./dist/external-links.umd.js"
    }
  },
  "devDependencies": {
    "@j-ulrich/release-it-regex-bumper": "^5.6.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.12.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "netlify-cli": "^23.15.1",
    "release-it": "^21.0.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^4.1.10"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "plugins": {
      "@j-ulrich/release-it-regex-bumper": {
        "out": [
          {
            "file": "README.md",
            "search": "\\d+-\\d+-\\d+",
            "replace": "{{major}}-{{minor}}-{{patch}}"
          }
        ]
      }
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    },
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run generate-docs",
        "npm run build",
        "npm run deploy-docs"
      ]
    }
  }
}
